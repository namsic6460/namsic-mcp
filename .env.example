# namsic-mcp 로컬 설정 — 이 파일을 .env 로 복사해 필요한 값만 주석을 풀어 바꾼다.
# 모두 선택 사항이며, 비워 두면 아래 기본값을 쓴다. 그 외 설정은 src/config.rs 상수다.

# MCP 서버 포트 (클라이언트: http://localhost:<port>/mcp)
#SERVER_PORT=8060

# adb 실행 파일 (PATH 에 없으면 절대 경로)
#ADB_PATH=adb

# 한글 등 비ASCII 입력용 ADBKeyboard.apk 호스트 경로 (github.com/senzhk/ADBKeyBoard)
#ADB_KEYBOARD_APK=C:/tools/ADBKeyboard.apk

# 로컬 LLM (OpenAI 호환 API, loopback HTTP origin 만 허용)
#LOCAL_LLM_BASE_URL=http://127.0.0.1:9000
#LOCAL_LLM_MODEL=qwen3.8-27b

# local_llm_* 도구가 읽을 수 있는 추가 이미지 루트 (; 구분)
#LOCAL_LLM_IMAGE_ROOTS=C:/path/one;C:/path/two

# 로그 레벨 (기본 info)
#RUST_LOG=info
